{
  "templates": [
    {
      "kind": "hypothesis",
      "title": "Гипотеза №{k}: участок {cell} дороже",
      "detail": "Предполагаем повышенный расход на участке {cell}.",
      "expected": "расход выше {energy} ед./м"
    },
    {
      "kind": "experiment",
      "title": "Проба №{k} на участке {cell}",
      "detail": "Короткий проход с сохранением запаса возврата."
    },
    {
      "kind": "observation",
      "title": "Замер №{n} на участке {cell}",
      "detail": "Расход измерен при сопоставимой скорости.",
      "observed": "{energy} ед./м на 0.3 м"
    },
    {
      "kind": "outcome",
      "title": "Вывод по гипотезе №{k}",
      "detail": "Сравнение с прогнозом завершено.",
      "conclusion": "Участок {cell}: {energy} ед./м — прогноз проверен."
    },
    {
      "kind": "decision",
      "title": "Решение №{n}: следующая цель",
      "detail": "Выбран участок {cell} как самый информативный."
    },
    {
      "kind": "error",
      "title": "Повтор запроса №{n}",
      "detail": "Планировщик ответил с задержкой; запрос повторён."
    }
  ]
}
