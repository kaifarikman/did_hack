{
  "name": "did-hack-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "rules": "node scripts/checks/index.ts",
    "verify": "npm run rules && npm run typecheck && npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "sync-examples": "node scripts/sync-examples.mjs",
    "e2e": "playwright test",
    "export-tokens": "node scripts/exportTokens.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
