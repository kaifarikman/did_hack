# Отдельный демо-стенд защиты: свой Compose project, ROS domain, Gazebo partition и порты.
# docker compose -p did-defense --env-file scripts/defense/defense.env up -d --build
# Секреты LLM сюда не записываются: backend читает их из корневого .env через переменные окружения.
ROS_DOMAIN_ID=91
GZ_PARTITION=did-defense
GUI_PORT=6090
FRONTEND_PORT=8090
