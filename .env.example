# Скопируйте в .env. Ключ передаётся только backend; без него работает явный fallback-планировщик.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=

# Общий бюджет попыток одного плана; должен быть меньше дедлайна исполнителя 10 с.
LLM_TIMEOUT_S=8
LLM_MAX_ATTEMPTS=2
# После двух неудачных запросов повторяем сеть только после паузы.
LLM_FAILURE_THRESHOLD=2
LLM_RECOVERY_COOLDOWN_S=30
